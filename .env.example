# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Connection URI (e.g. mongodb+srv://user:pass@cluster.mongodb.net/finpath?retryWrites=true&w=majority)
# If left blank, FinPath automatically uses resilient in-memory MongoDB collections for testing.
MONGODB_URI=

# Cryptographic secrets for OTP HMAC-SHA256 and Session generation
OTP_SECRET=
SESSION_SECRET=

# SMS Provider Configuration:
# Set MOCK_SMS=true for development & hackathon demonstrations (dispatches logged on server console)
MOCK_SMS=true
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
